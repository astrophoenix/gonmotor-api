# ============================================================================
# Gonmotor API — Variables de entorno (copia este archivo a `.env`)
# ============================================================================

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=gonmotor
DB_USER=gonmotor
DB_PASSWORD=gonmotor123
DB_HOST=localhost
DB_PORT=5432
FRONTEND_URL=http://localhost:1313

# Motor de mejora de texto (LLM compatible OpenAI). Vacío = desactivado.
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=https://api.groq.com/openai/v1
AI_TEXT_MODEL=
AI_TEXT_TIMEOUT=30

# ============================================================================
# WHATSAPP / RECORDATORIOS DE MANTENIMIENTO (0 USD en modo pruebas)
#
# Modos disponibles (WHATSAPP_MODE):
#   1. mock           -> Default. NO hace llamadas reales: simula el envío,
#                        lo guarda en la bitácora y en WHATSAPP_MOCK_LOG_FILE.
#                        No requiere credenciales.
#   2. twilio_sandbox -> Sandbox gratuito de Twilio (crédito de prueba).
#   3. meta_api       -> Meta WhatsApp Cloud API, entorno de prueba para devs.
#
# Documentación completa: apps/notificaciones/services/whatsapp.py
# ============================================================================

WHATSAPP_MODE=mock
WHATSAPP_MOCK_LOG_FILE=logs/whatsapp_mock.log

# Opción 2: Twilio (obtener en https://console.twilio.com, Sandbox gratuito)
# WHATSAPP_MODE=twilio_sandbox
# WHATSAPP_TWILIO_ACCOUNT_SID=
# WHATSAPP_TWILIO_AUTH_TOKEN=
# WHATSAPP_TWILIO_FROM_NUMBER=whatsapp:+14155238886

# Opción 3: Meta Cloud API (https://developers.facebook.com, modo de pruebas)
# WHATSAPP_MODE=meta_api
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=